{:id       :isaac.worksite
 :version  "0.1.0"
 :builtin? true
 :factory  isaac.module.protocol/module

 :isaac.agent/turnstiles
 {:worksite {:factory isaac.worksite.turnstile/worksite}}

 :isaac/cli
 {:worksites {:usage     "worksites [subcommand] [options]"
              :summary   "List, lock, and unlock named worksites"
              :namespace isaac.worksite.cli}}

 :isaac.config/schema
 {:worksites {:entity-dir         "worksites"
              :merge-root-entity? true
              :schema
              {:name        "worksite table"
               :type        :map
               :description "Worksite configurations (map of name -> worksite)"
               :key-spec    {:type :string}
               :value-spec
               {:name        :worksite
                :type        :map
                :schema      {:members {:type        :seq
                                        :description "Absolute directory paths (pool members; one = singleton)"
                                        :spec        {:type :string}}}}}}}

 :isaac.config/check
 {:worksite-members {:fn isaac.worksite.checks/check-worksite-members}}}
